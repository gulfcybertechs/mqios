[{"Words":[{"Verse":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","Transliteration":"Bismi-LLâhir-Raḥmânir-Raḥeem","Word":"1"}],"VerseColor":"بِسْمِ ٱللَّهِ ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eرَّ\u003c/span\u003eحْمَ\u003cspan style=\"color: #808000;\"\u003eـٰ\u003c/span\u003eنِ ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eرَّ\u003c/span\u003eحِ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eمِ","TransliterationColor":"Bismi-Llâhi#6#6r#6-#6Raḥmâni#6#6r#6-#6Raḥ#3e#3em","id":6237,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":1,"Page":1,"Juzu":1,"Verse":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","Transliteration":"Bismi-Llâhir-Raḥmânir-Raḥeem","Verse_":"باسم الله أبدأ قراءة القرآن، مستعينًا به تعالى متبركًا بذكر اسمه. وقد تضمنت البسملة ثلاثة من أسماء الله الحسنى، وهي:\n• «الله»، أي: المعبود بحق، وهو أخص أسماء الله تعالى، ولا يسمى به غيره سبحانه.\n• «الرَّحْمَن»، أي: ذو الرحمة الواسعة. فهو الرحمن بذاته.\n• «الرَّحِيم»، أي: ذو الرحمة الواصلة. فهو يرحم برحمته من شاء من خلقه ومنهم المؤمنون من عباده."},{"Words":[{"Verse":"ٱلْحَمْدُ","Transliteration":"\u0027AI-Ḥamdu","Word":"2"},{"Verse":"لِلَّهِ","Transliteration":"li-LLâhi","Word":"3"},{"Verse":"رَبِّ ٱلْعَـٰلَمِينَ","Transliteration":"Rabbil-❛âlameen","Word":"4"}],"VerseColor":"ٱلْحَمْدُ لِلَّهِ \u003cspan style=\"color: #003366;\"\u003eرَ\u003c/span\u003eبِّ ٱلْعَ\u003cspan style=\"color: #808000;\"\u003eـٰ\u003c/span\u003eلَمِ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eنَ","TransliterationColor":"\u0027AI-Ḥamdu li-LLâhi #6Rabbil-❛âlam#3e#3en","id":6238,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":2,"Page":1,"Juzu":1,"Verse":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","Transliteration":"\u0027AI-Ḥamdu li-LLâhi Rabbil-❛âlameen","Verse_":"جميع أنواع المحامد من صفات الجلال والكمال هي له وحده دون من سواه، إذ هو رب كل شيء وخالقه ومدبره. و«العالمون» جمع «عالَم» وهم كل ما سوى الله تعالى."},{"Words":[{"Verse":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","Transliteration":"\u0027Ar-Raḥmânir-Raḥeem","Word":"5"}],"VerseColor":"ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eرَّ\u003c/span\u003eحْمَ\u003cspan style=\"color: #808000;\"\u003eـٰ\u003c/span\u003eنِ ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eرَّ\u003c/span\u003eحِ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eمِ","TransliterationColor":"\u0027A#6#6r#6-#6Raḥmâni#6#6r#6-#6Raḥ#3e#3em","id":6239,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":3,"Page":1,"Juzu":1,"Verse":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","Transliteration":"\u0027Ar-Raḥmânir-Raḥeem","Verse_":"ثناء على الله تعالى بعد حمده في الآية السابقة."},{"Words":[{"Verse":"مَـٰلِكِ","Transliteration":"Mâliki","Word":"6"},{"Verse":"يَوْمِ ٱلدِّينِ","Transliteration":"Yawmid-Deen","Word":"7"}],"VerseColor":"مَ\u003cspan style=\"color: #808000;\"\u003eـٰ\u003c/span\u003eلِكِ يَوْمِ ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003eدِّ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eنِ","TransliterationColor":"Mâliki Yawmid-D#3e#3en","id":6240,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":4,"Page":1,"Juzu":1,"Verse":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","Transliteration":"Mâliki Yawmid-Deen","Verse_":"تمجيد لله تعالى بأنه المالك لكل ما في يوم القيامة، حيث لا تملك نفس لنفس شيئًا. فـ«يوم الدين»: يوم الجزاء والحساب."},{"Words":[{"Verse":"إِيَّاكَ","Transliteration":"\u0027lyyâka","Word":"8"},{"Verse":"نَعْبُدُ","Transliteration":"na❛-budu","Word":"9"},{"Verse":"وَإِيَّاكَ","Transliteration":"wa \u0027iyyâka","Word":"10"},{"Verse":"نَسْتَعِينُ","Transliteration":"nasta-❛een","Word":"11"}],"VerseColor":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eنُ","TransliterationColor":"\u0027lyyâka na❛-budu wa \u0027iyyâka nasta-❛#3e#3en","id":6241,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":5,"Page":1,"Juzu":1,"Verse":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","Transliteration":"\u0027lyyâka na❛-budu wa \u0027iyyâka nasta-❛een","Verse_":"نخصُّك وحدك بأنواع العبادة والطاعة، فلا نشرك معك غيرك، ومنك وحدك نطلب العون في كل شؤوننا، فبِيَدِكَ الخير كله، ولا مُعين سواك."},{"Words":[{"Verse":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","Transliteration":"\u0027Ihdinaṣ-ṣirâṭal-Musta-q̇eem","Word":"12"}],"VerseColor":"ٱهْدِنَا ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eصِّرَٰطَ\u003c/span\u003e ٱلْمُسْتَ\u003cspan style=\"color: #003366;\"\u003eقِ\u003c/span\u003e\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eمَ","TransliterationColor":"\u0027Ihdina#6ṣ#6-#6ṣi#6#6râ#6#6ṭal-Musta-#6q̇#3e#3em","id":6242,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":6,"Page":1,"Juzu":1,"Verse":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","Transliteration":"\u0027Ihdinaṣ-ṣirâṭal-Musta-q̇eem","Verse_":"دُلَّنا إلى الصراط المستقيم، واسلك بنا فيه، وثبِّتنا عليه.، وزدنا هدى. و«الصراط المستقيم» هو الطريق الواضح الذي لا اعوجاج فيه، وهو الإسلام الذي أرسل الله به محمدًا ﷺ."},{"Words":[{"Verse":"صِرَٰطَ ٱلَّذِينَ","Transliteration":"Ṣirâṭal-laẓeena","Word":"13"},{"Verse":"أَنْعَمْتَ","Transliteration":"\u0027an-❛amta","Word":"14"},{"Verse":"عَلَيْهِمْ","Transliteration":"❛alay-him","Word":"15"},{"Verse":"غَيْرِ ٱلْمَغْضُوبِ","Transliteration":"ġayril-maġḍoubi","Word":"16"},{"Verse":"عَلَيْهِمْ","Transliteration":"❛alayhim","Word":"17"},{"Verse":"وَلَا ٱلضَّآلِّينَ","Transliteration":"wa laḍ-ḍâlleen","Word":"18"}],"VerseColor":"\u003cspan style=\"color: #003366;\"\u003eصِرَٰطَ\u003c/span\u003e ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ \u003cspan style=\"color: #003366;\"\u003eغَ\u003c/span\u003eيْرِ ٱلْمَ\u003cspan style=\"color: #003366;\"\u003eغْضُ\u003c/span\u003eوبِ عَلَيْهِمْ وَلَا ٱ\u003cspan style=\"color: #808080;\"\u003eل\u003c/span\u003e\u003cspan style=\"color: #003366;\"\u003eضَّ\u003c/span\u003e\u003cspan style=\"color: #993366;\"\u003eآ\u003c/span\u003eلِّ\u003cspan style=\"color: #ff6600;\"\u003eي\u003c/span\u003eنَ","TransliterationColor":"#6Ṣi#6#6râ#6#6ṭal-laẓeena \u0027an-❛amta ❛alay-him #6ġay#6ril-ma#6ġ#6ḍoubi ❛alayhim wa la#6ḍ#6-#6ḍ#1âll#3e#3en","id":6243,"Surah":1,"SurahNameAr":"سُوْرَۃُ الفَاتِحَة","SurahNameTr":"FÂTIḤAH","SurahName":"Surah al-Fatihah","SurahNameSwa":"","SurahNameFr":" Prologue","SurahNamePt":null,"SurahNameEs":null,"SurahNameRu":null,"SurahNameDe":null,"SurahNameHi":null,"SurahNameZh":null,"Ayah":7,"Page":1,"Juzu":1,"Verse":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","Transliteration":"Ṣirâṭal-laẓeena \u0027an-❛amta ❛alay-him ġayril-maġḍoubi ❛alayhim wa laḍ-ḍâlleen","Verse_":"طريق الذين أنعمت عليهم من عبادك بهدايتهم، كالنبيين والصدِّيقين والشهداء والصالحين وحَسُنَ أولئك رفيقًا، غير طريق المغضوب عليهم الذين عرفوا الحق ولم يتبعوه كاليهود، وغير طريق الضالين عن الحق الذين لم يهتدوا إليه لتفريطهم في طلب الحق والاهتداء إليه كالنصارى.\n* من فوائد الآيات:\n• افتتح الله تعالى كتابه بالبسملة، ليرشد عباده أن يبدؤوا أعمالهم وأقوالهم بها طلبًا لعونه وتوفيقه.\n• من هدي عباد الله الصالحين في الدعاء البدء بتمجيد الله والثناء عليه سبحانه ثم ليشرع في الطلب.\n• تحذير المسلمين من التقصير في طلب الحق كالنصارى الضالين، أو عدم العمل بالحق الذي عرفوه كاليهود المغضوب عليهم.\n• دلَّت السورة على أن كمال الإيمان يكون بإخلاص العبادة لله تعالى وطلب العون منه وحده دون سواه."}]